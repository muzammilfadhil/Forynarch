<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN" "http://www.freedesktop.org/standards/PolicyKit/1.0/policyconfig.dtd">
<policyconfig>
  <vendor>Forynarch</vendor>
  <action id="org.forynarch.bluetooth.recover">
    <description>Enable the Bluetooth service and radio</description>
    <message>Authenticate to start Bluetooth and clear its software radio block.</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/libexec/forynarch-bluetooth-recover</annotate>
  </action>
</policyconfig>
