polkit.addRule(function(action, subject) {
    if ((action.id === "org.forynarch.install-app" || action.id === "org.forynarch.install-system" || action.id === "org.forynarch.bluetooth.recover" || action.id === "org.kde.kpmcore.externalcommand.init") && subject.local && subject.active && subject.user === "liveuser") {
        try {
            polkit.spawn(["/usr/bin/test", "-d", "/run/archiso"]);
            return polkit.Result.YES;
        } catch (error) { return polkit.Result.NOT_HANDLED; }
    }
});
