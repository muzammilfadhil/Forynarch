# Linux scripts use LF, even when edited on Windows
.gitattributes text eol=lf
.gitignore text eol=lf
*.sh text eol=lf
*.zsh text eol=lf
config/zsh/.zshrc text eol=lf
*.toml text eol=lf
*.lua text eol=lf
*.conf text eol=lf
*.plymouth text eol=lf
*.script text eol=lf
config/os-release text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
# Markdown uses intentional two-space hard line breaks, including vision.md.
*.md text eol=lf whitespace=-blank-at-eol
*.txt text eol=lf
*.py text eol=lf
*.json text eol=lf
*.jsonc text eol=lf
*.svg text eol=lf
*.service text eol=lf
*.qml text eol=lf
*.js text eol=lf
*.jq text eol=lf
*.theme text eol=lf
*.xml text eol=lf
*.override text eol=lf
*.desktop text eol=lf
*.frag text eol=lf
*.ini text eol=lf
*.css text eol=lf
*.ps1 text eol=lf
config/mako/config text eol=lf
